<Window x:Class="DesktopOverlayBoard.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        Height="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#EA182230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Task"
        Tag="Dialog.TaskTitle">
    <Border CornerRadius="0"
            Background="#EA182230"
            BorderBrush="#46FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Foreground="{StaticResource WidgetInk}" FontWeight="SemiBold" FontSize="15"/>
                <Button Grid.Column="1" Content="x" Click="Cancel_Click" Style="{StaticResource ToolButtonStyle}" FontSize="16" Padding="8,2"/>
            </Grid>
            <TextBox x:Name="TaskTextBox"
                     Grid.Row="1"
                     Margin="0,14,0,14"
                     AcceptsReturn="False"
                     Foreground="{StaticResource WidgetInk}"
                     CaretBrush="White"
                     Background="#24FFFFFF"
                     BorderBrush="#48FFFFFF"
                     BorderThickness="1"
                     Padding="9,6"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Tag="Action.Cancel" MinWidth="78" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButtonStyle}"/>
                <Button Content="OK" Tag="Action.Ok" MinWidth="78" Click="Ok_Click" Style="{StaticResource ToolButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
