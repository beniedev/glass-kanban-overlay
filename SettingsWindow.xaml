<Window x:Class="DesktopOverlayBoard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="500"
        MinWidth="660"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Title="Glass Kanban settings"
        Tag="Dialog.SettingsTitle">
    <Window.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource WidgetInk}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource WidgetInk}"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource WidgetInk}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource WidgetInk}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1D2733"/>
            <Setter Property="Background" Value="#D8FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14"
            Background="#EA182230"
            BorderBrush="#46FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.34" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="8" Background="#FFE45D" Margin="0,0,10,0">
                        <TextBlock Text="K" Foreground="#5F4700" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Glass Kanban settings"
                               Tag="Dialog.SettingsTitle"
                               Foreground="{StaticResource WidgetInk}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="x"
                        Click="CloseButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        FontSize="16"
                        Padding="8,2"
                        ToolTip="Close"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="New board" Tag="Action.NewBoard" Style="{StaticResource SettingsButtonStyle}" Margin="0,0,8,0" Click="NewBoardButton_Click"/>
                        <Button Content="Add existing" Tag="Action.AddExistingBoard" Style="{StaticResource SettingsButtonStyle}" Margin="0,0,8,0" Click="AddExistingButton_Click"/>
                        <Button Content="Remove" Tag="Action.Remove" Style="{StaticResource SettingsButtonStyle}" Click="RemoveButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="BoardsList" DisplayMemberPath="DisplayName" SelectionChanged="BoardsList_SelectionChanged"/>
                </DockPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Display name" Tag="Label.DisplayName" Foreground="{StaticResource WidgetMutedInk}" VerticalAlignment="Center"/>
                    <TextBox x:Name="DisplayNameBox" Grid.Column="1" Margin="0,0,0,9" TextChanged="DisplayNameBox_TextChanged" Style="{StaticResource SettingsTextBoxStyle}"/>

                    <TextBlock Grid.Row="1" Text="Vault" Tag="Label.Vault" Foreground="{StaticResource WidgetMutedInk}" VerticalAlignment="Center"/>
                    <TextBox x:Name="VaultNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" TextChanged="VaultNameBox_TextChanged" Style="{StaticResource SettingsTextBoxStyle}"/>

                    <TextBlock Grid.Row="2" Text="Default column" Tag="Label.DefaultColumn" Foreground="{StaticResource WidgetMutedInk}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ColumnCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,9" SelectionChanged="ColumnCombo_SelectionChanged"/>

                    <TextBlock Grid.Row="3" Text="Language" Tag="Label.Language" Foreground="{StaticResource WidgetMutedInk}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,9" SelectionChanged="LanguageCombo_SelectionChanged"/>

                    <CheckBox x:Name="EnabledCheck" Grid.Row="4" Grid.Column="1" Content="Enable this board" Tag="Label.EnableBoard" Margin="0,0,0,9" Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed"/>

                    <TextBox x:Name="PathBox"
                             Grid.Row="5"
                             Grid.ColumnSpan="2"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource SettingsTextBoxStyle}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="10" BorderBrush="#34FFFFFF" BorderThickness="1" CornerRadius="8" Background="#14FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="StartMinimizedCheck"
                              Content="Start minimized to tray"
                              Tag="Label.StartMinimized"
                              Margin="0,0,24,0"
                              Checked="StartupCheck_Changed"
                              Unchecked="StartupCheck_Changed"/>
                    <CheckBox x:Name="StartWithWindowsCheck"
                              Content="Start with Windows"
                              Tag="Label.StartWithWindows"
                              Checked="StartupCheck_Changed"
                              Unchecked="StartupCheck_Changed"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Tag="Action.Cancel" Style="{StaticResource SettingsButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Save" Tag="Action.Save" Style="{StaticResource SettingsButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
