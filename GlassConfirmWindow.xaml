<Window x:Class="DesktopOverlayBoard.GlassConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        Height="190"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border x:Name="RootGlass"
            CornerRadius="14"
            Background="#E0182230"
            BorderBrush="#48FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.34" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource WidgetInk}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="x"
                        Click="Cancel_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        FontSize="16"
                        Padding="7,1"
                        ToolTip="Cancel"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#2EFFFFFF"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,0,12,0">
                    <TextBlock Text="?"
                               Foreground="{StaticResource WidgetInk}"
                               FontSize="19"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Foreground="{StaticResource WidgetInk}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="Cancel_Click"
                        MinWidth="82"
                        Style="{StaticResource ToolButtonStyle}"/>
                <Button x:Name="ConfirmButton"
                        Content="OK"
                        Click="Confirm_Click"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
