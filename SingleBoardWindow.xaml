<Window x:Class="DesktopOverlayBoard.SingleBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="580"
        MinWidth="320"
        MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Border x:Name="RootGlass"
            Background="Transparent"
            CornerRadius="18"
            PreviewMouseLeftButtonDown="RootGlass_PreviewMouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="TopmostMenuItem" Header="Always on top" Tag="Action.Topmost" IsCheckable="True" Click="TopmostMenuItem_Click"/>
                <MenuItem x:Name="NormalMenuItem" Header="Normal window" Tag="Action.NormalWindow" IsCheckable="True" Click="NormalMenuItem_Click"/>
                <MenuItem x:Name="DesktopMenuItem" Header="Stay on desktop" Tag="Action.DesktopWidget" IsCheckable="True" Click="DesktopMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="LockMenuItem" Header="Lock position" Tag="Action.LockPosition" IsCheckable="True" Click="LockMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Configure boards" Tag="Action.ConfigureBoards" Click="ConfigureMenuItem_Click"/>
                <MenuItem Header="Appearance" Tag="Action.Theme">
                    <MenuItem Header="Ink" Tag="Action.Ink" CommandParameter="ink" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="Blue" Tag="Action.Blue" CommandParameter="blue" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="Green" Tag="Action.Green" CommandParameter="green" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="Plum" Tag="Action.Plum" CommandParameter="plum" Click="ThemeMenuItem_Click"/>
                    <MenuItem Header="Amber" Tag="Action.Amber" CommandParameter="amber" Click="ThemeMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Refresh" Tag="Action.Refresh" Click="RefreshMenuItem_Click"/>
                <MenuItem Header="Open source Markdown file" Tag="Action.OpenSource" Click="OpenButton_Click"/>
                <MenuItem Header="Close this window" Tag="Action.CloseWindow" Click="CloseButton_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Border x:Name="TitleChrome"
                    Visibility="Collapsed"
                    CornerRadius="18,18,0,0"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid x:Name="TitleBar" Margin="12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#FFE45D" Margin="0,0,9,0">
                            <TextBlock Text="K" Foreground="#5F4700" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Foreground="{StaticResource PanelInk}" FontWeight="SemiBold" FontSize="14"/>
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                CornerRadius="8"
                                Background="#73FFFFFF"
                                BorderBrush="#B8FFFFFF"
                                BorderThickness="1">
                            <TextBlock x:Name="PinModeText" Text="Pinned" Foreground="{StaticResource PanelMutedInk}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+" Click="AddButton_Click" Style="{StaticResource ToolButtonStyle}"/>
                        <Button Content="Source" Tag="Action.Source" Click="OpenButton_Click" Style="{StaticResource ToolButtonStyle}"/>
                        <Button Content="x" Click="CloseButton_Click" Style="{StaticResource ToolButtonStyle}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WidgetCard"
                    Margin="0"
                    CornerRadius="4"
                    Background="#B1121724"
                    Padding="24,22"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.24" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="MainTitleText"
                                       Foreground="{StaticResource WidgetInk}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="MainTitleText_MouseLeftButtonDown"
                                       ToolTip="Double-click to edit title"/>
                            <TextBlock x:Name="ColumnText"
                                       Foreground="{StaticResource WidgetMutedInk}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="ColumnText_MouseLeftButtonDown"
                                       ToolTip="Double-click to edit note"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="LockButton" Click="LockButton_Click" Style="{StaticResource ToolButtonStyle}" FontSize="13"/>
                            <Button x:Name="ColumnMenuButton" Content="..." Click="ColumnMenuButton_Click" Style="{StaticResource ToolButtonStyle}" FontSize="16" ToolTip="Board actions">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Refresh" Tag="Action.Refresh" Click="RefreshMenuItem_Click"/>
                                        <MenuItem Header="Open source Markdown file" Tag="Action.OpenSource" Click="OpenButton_Click"/>
                                        <MenuItem Header="Configure boards" Tag="Action.ConfigureBoards" Click="ConfigureMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Appearance" Tag="Action.Theme">
                                            <MenuItem Header="Ink" Tag="Action.Ink" CommandParameter="ink" Click="ThemeMenuItem_Click"/>
                                            <MenuItem Header="Blue" Tag="Action.Blue" CommandParameter="blue" Click="ThemeMenuItem_Click"/>
                                            <MenuItem Header="Green" Tag="Action.Green" CommandParameter="green" Click="ThemeMenuItem_Click"/>
                                            <MenuItem Header="Plum" Tag="Action.Plum" CommandParameter="plum" Click="ThemeMenuItem_Click"/>
                                            <MenuItem Header="Amber" Tag="Action.Amber" CommandParameter="amber" Click="ThemeMenuItem_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Window mode" Tag="Action.WindowMode">
                                            <MenuItem Header="Always on top" Tag="Action.Topmost" Click="TopmostMenuItem_Click"/>
                                            <MenuItem Header="Normal window" Tag="Action.NormalWindow" Click="NormalMenuItem_Click"/>
                                            <MenuItem Header="Stay on desktop" Tag="Action.DesktopWidget" Click="DesktopMenuItem_Click"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Close this window" Tag="Action.CloseWindow" Click="CloseButton_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Tag="Label.Opacity" Foreground="{StaticResource WidgetMutedInk}" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="OpacitySlider"
                                Grid.Column="1"
                                Minimum="0.2"
                                Maximum="0.95"
                                ValueChanged="OpacitySlider_ValueChanged"
                                Margin="10,0,0,0"/>
                    </Grid>

                    <ScrollViewer x:Name="TasksScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TasksPanel"/>
                    </ScrollViewer>

                    <Button x:Name="AddCardButton"
                            Grid.Row="3"
                            Content="+ Add card"
                            Tag="Action.AddCard"
                            Click="AddButton_Click"
                            Margin="0,10,0,0"
                            Style="{StaticResource ToolButtonStyle}"
                            HorizontalAlignment="Stretch"
                            ToolTip="New task"/>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="4"
                               Foreground="{StaticResource WidgetMutedInk}"
                               FontSize="11"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
